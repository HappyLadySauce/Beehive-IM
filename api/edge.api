syntax = "v1"

info (
	title:  "Beehive-IM Edge API"
	desc:   "Public WebSocket edge API for Beehive-IM"
	author: "Beehive-IM"
)

type TicketRequest {
	DeviceId  string `json:"device_id,optional"`
	SessionId string `json:"session_id,optional"`
}

type TicketResponse {
	Ticket    string `json:"ticket"`
	ExpiresIn int64  `json:"expires_in"`
	SessionId string `json:"session_id"`
	DeviceId  string `json:"device_id"`
}

type HealthResponse {
	Status string `json:"status"`
}

type AuthUserInfo {
	Id       string `json:"id"`
	Username string `json:"username"`
	Email    string `json:"email,optional"`
	Avatar   string `json:"avatar,optional"`
}

type RegisterRequest {
	Username string `json:"username"`
	Email    string `json:"email,optional"`
	Phone    string `json:"phone,optional"`
	Password string `json:"password"`
}

type LoginRequest {
	Account  string `json:"account"`
	Password string `json:"password"`
}

type RefreshTokenRequest {
	RefreshToken string `json:"refresh_token"`
}

type LogoutRequest {
	RefreshToken string `json:"refresh_token"`
}

type AuthTokenResponse {
	AccessToken  string       `json:"access_token"`
	RefreshToken string       `json:"refresh_token"`
	ExpiresIn    int64        `json:"expires_in"`
	TokenType    string       `json:"token_type"`
	User         AuthUserInfo `json:"user"`
}

type EmptyResponse {
	Success   bool   `json:"success"`
	ErrorCode string `json:"error_code,optional"`
	Message   string `json:"message,optional"`
}

type MessageItem {
	MessageId      string `json:"message_id"`
	ConversationId string `json:"conversation_id"`
	Seq            int64  `json:"seq"`
	SenderId       string `json:"sender_id"`
	DeviceId       string `json:"device_id"`
	ClientMsgId    string `json:"client_msg_id"`
	ClientSeq      int64  `json:"client_seq"`
	ContentType    string `json:"content_type"`
	ContentJson    string `json:"content_json"`
	CreatedAt      string `json:"created_at"`
}

type ListMessagesRequest {
	ConversationId string `path:"conversation_id"`
	AfterSeq       int64  `form:"after_seq,optional"`
	BeforeSeq      int64  `form:"before_seq,optional"`
	Direction      string `form:"direction,optional"`
	Limit          int32  `form:"limit,optional"`
}

type ListMessagesResponse {
	Accepted  bool          `json:"accepted"`
	ErrorCode string        `json:"error_code,optional"`
	Message   string        `json:"message"`
	Messages  []MessageItem `json:"messages"`
	LatestSeq int64         `json:"latest_seq"`
}

type ConversationCursor {
	ConversationId string `json:"conversation_id"`
	LastSeq        int64  `json:"last_seq"`
}

type SyncMessagesRequest {
	Cursors              []ConversationCursor `json:"cursors"`
	LimitPerConversation int32                `json:"limit_per_conversation,optional"`
}

type ConversationSyncResult {
	ConversationId string        `json:"conversation_id"`
	Messages       []MessageItem `json:"messages"`
	LatestSeq      int64         `json:"latest_seq"`
}

type SyncMessagesResponse {
	Accepted      bool                     `json:"accepted"`
	ErrorCode     string                   `json:"error_code,optional"`
	Message       string                   `json:"message"`
	Conversations []ConversationSyncResult `json:"conversations"`
}

type AckMessagesRequest {
	ConversationId string  `json:"conversation_id"`
	AckType        string  `json:"ack_type"`
	Seqs           []int64 `json:"seqs"`
}

type AckMessagesResponse {
	Accepted  bool   `json:"accepted"`
	ErrorCode string `json:"error_code,optional"`
	Message   string `json:"message"`
	Updated   int32  `json:"updated"`
}

type MemberInput {
	UserId string `json:"user_id"`
	Role   string `json:"role,optional"`
}

type Conversation {
	ConversationId string `json:"conversation_id"`
	Type           string `json:"type"`
	Status         string `json:"status"`
	Title          string `json:"title"`
	OwnerUserId    string `json:"owner_user_id"`
	CurrentSeq     int64  `json:"current_seq"`
	CreatedAt      string `json:"created_at"`
	UpdatedAt      string `json:"updated_at"`
}

type ConversationMember {
	ConversationId   string `json:"conversation_id"`
	UserId           string `json:"user_id"`
	Role             string `json:"role"`
	Status           string `json:"status"`
	MutedUntil       string `json:"muted_until,optional"`
	JoinedAt         string `json:"joined_at"`
	UpdatedAt        string `json:"updated_at"`
	VisibleFromSeq   int64  `json:"visible_from_seq"`
	VisibleToSeq     int64  `json:"visible_to_seq"`
	LastReadSeq      int64  `json:"last_read_seq"`
	LastDeliveredSeq int64  `json:"last_delivered_seq"`
	LastReadAt       string `json:"last_read_at,optional"`
}

type ConversationSettings {
	ConversationId string `json:"conversation_id"`
	UserId         string `json:"user_id"`
	Pinned         bool   `json:"pinned"`
	MutedUntil     string `json:"muted_until,optional"`
	Remark         string `json:"remark,optional"`
	UpdatedAt      string `json:"updated_at"`
}

type ConversationListItem {
	Conversation Conversation         `json:"conversation"`
	Member       ConversationMember   `json:"member"`
	Settings     ConversationSettings `json:"settings"`
	MemberCount  int32                `json:"member_count"`
	LastMessage  MessageItem          `json:"last_message,optional"`
	LatestSeq    int64                `json:"latest_seq"`
	UnreadCount  int64                `json:"unread_count"`
}

type ConversationResponse {
	Accepted     bool                 `json:"accepted"`
	ErrorCode    string               `json:"error_code,optional"`
	Message      string               `json:"message"`
	Conversation Conversation         `json:"conversation"`
	Members      []ConversationMember `json:"members,optional"`
	Settings     ConversationSettings `json:"settings,optional"`
}

type CreateDirectConversationRequest {
	PeerUserId string `json:"peer_user_id"`
	Title      string `json:"title,optional"`
}

type CreateGroupConversationRequest {
	Title   string        `json:"title"`
	Members []MemberInput `json:"members"`
}

type ListConversationsRequest {
	Limit  int32 `form:"limit,optional"`
	Offset int32 `form:"offset,optional"`
}

type ListConversationsResponse {
	Items []ConversationListItem `json:"items"`
}

type GetConversationRequest {
	ConversationId string `path:"conversation_id"`
}

type AddConversationMembersRequest {
	ConversationId string        `path:"conversation_id"`
	Members        []MemberInput `json:"members"`
}

type RemoveConversationMemberRequest {
	ConversationId string `path:"conversation_id"`
	UserId         string `path:"user_id"`
}

type UpdateMemberRoleRequest {
	ConversationId string `path:"conversation_id"`
	UserId         string `path:"user_id"`
	Role           string `json:"role"`
}

type UpdateConversationSettingsRequest {
	ConversationId string `path:"conversation_id"`
	Pinned         bool   `json:"pinned"`
	MutedUntil     string `json:"muted_until,optional"`
	Remark         string `json:"remark,optional"`
}

type ConversationActionRequest {
	ConversationId string `path:"conversation_id"`
}

type TransferOwnerRequest {
	ConversationId string `path:"conversation_id"`
	TargetUserId   string `json:"target_user_id"`
}

service edge-api {
	@handler healthz
	get /healthz returns (HealthResponse)

	@handler register
	post /v1/auth/register (RegisterRequest) returns (AuthTokenResponse)

	@handler login
	post /v1/auth/login (LoginRequest) returns (AuthTokenResponse)

	@handler refreshToken
	post /v1/auth/refresh (RefreshTokenRequest) returns (AuthTokenResponse)

	@handler logout
	post /v1/auth/logout (LogoutRequest) returns (EmptyResponse)

	@handler createWsTicket
	post /v1/ws/ticket (TicketRequest) returns (TicketResponse)

	@handler websocket
	get /ws

	@handler listMessages
	get /v1/conversations/:conversation_id/messages (ListMessagesRequest) returns (ListMessagesResponse)

	@handler syncMessages
	post /v1/messages/sync (SyncMessagesRequest) returns (SyncMessagesResponse)

	@handler ackMessages
	post /v1/messages/ack (AckMessagesRequest) returns (AckMessagesResponse)

	@handler createDirectConversation
	post /v1/conversations/direct (CreateDirectConversationRequest) returns (ConversationResponse)

	@handler createGroupConversation
	post /v1/conversations/group (CreateGroupConversationRequest) returns (ConversationResponse)

	@handler listConversations
	get /v1/conversations (ListConversationsRequest) returns (ListConversationsResponse)

	@handler getConversation
	get /v1/conversations/:conversation_id (GetConversationRequest) returns (ConversationResponse)

	@handler addConversationMembers
	post /v1/conversations/:conversation_id/members (AddConversationMembersRequest) returns (ConversationResponse)

	@handler removeConversationMember
	delete /v1/conversations/:conversation_id/members/:user_id (RemoveConversationMemberRequest) returns (EmptyResponse)

	@handler updateMemberRole
	patch /v1/conversations/:conversation_id/members/:user_id/role (UpdateMemberRoleRequest) returns (ConversationResponse)

	@handler updateConversationSettings
	patch /v1/conversations/:conversation_id/settings (UpdateConversationSettingsRequest) returns (ConversationResponse)

	@handler leaveConversation
	post /v1/conversations/:conversation_id/leave (ConversationActionRequest) returns (EmptyResponse)

	@handler dismissConversation
	post /v1/conversations/:conversation_id/dismiss (ConversationActionRequest) returns (EmptyResponse)

	@handler transferOwner
	post /v1/conversations/:conversation_id/transfer-owner (TransferOwnerRequest) returns (ConversationResponse)
}
